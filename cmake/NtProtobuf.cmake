#
# Generates C++ classes for Protocol Buffers messages with ntprotobufgen.
#
#   nt_add_protobuf(<target> PROTO_FILES <file>... [PROTO_INCLUDES <dir>...] [OUTPUT_DIRECTORY <dir>]
#                   [OUTPUT_HEADERS <var>] [OUTPUT_TARGETS <var>] [...options of qt_add_protobuf that are ignored])
#   qt_add_protobuf(...) and qt6_add_protobuf(...)   the same, under the names of Qt
#
# The target is made a static library linked with Nt::Protobuf if it does not exist; otherwise the generated sources are
# added to it. Each file.proto gives <OUTPUT_DIRECTORY>/<path>.qpb.h and .qpb.cpp, where <path> is the file's path under
# the first PROTO_INCLUDES directory that holds it, or else its name; OUTPUT_DIRECTORY (the current binary directory by
# default) is added to the include path of the target, so that the headers are included as "<path>.qpb.h".

if(NOT TARGET ntprotobufgen)
    message(FATAL_ERROR "NtProtobuf.cmake needs the ntprotobufgen target")
endif()

function(nt_add_protobuf target)
    cmake_parse_arguments(arg
        "GENERATE_PACKAGE_SUBFOLDERS;COPY_COMMENTS;QML;GENERATE_NON_FINAL_MESSAGES;GENERATE_NON_FINAL_PROPERTIES"
        "OUTPUT_DIRECTORY;EXPORT_MACRO;OUTPUT_HEADERS;OUTPUT_TARGETS;HEADER_GUARD;QML_URI"
        "PROTO_FILES;PROTO_INCLUDES" ${ARGN})
    if(NOT arg_PROTO_FILES)
        message(FATAL_ERROR "nt_add_protobuf(${target}) needs PROTO_FILES")
    endif()
    if(arg_QML)
        message(WARNING "nt_add_protobuf(${target}): QML types are not generated by Nt")
    endif()
    set(outdir "${arg_OUTPUT_DIRECTORY}")
    if(NOT outdir)
        set(outdir "${CMAKE_CURRENT_BINARY_DIR}")
    endif()
    set(includes)
    foreach(dir IN LISTS arg_PROTO_INCLUDES)
        get_filename_component(dir "${dir}" ABSOLUTE)
        list(APPEND includes "${dir}")
    endforeach()

    set(headers)
    set(sources)
    foreach(proto IN LISTS arg_PROTO_FILES)
        get_filename_component(abs "${proto}" ABSOLUTE)
        get_filename_component(protodir "${abs}" DIRECTORY)
        set(rel "")
        foreach(dir IN LISTS includes)
            file(RELATIVE_PATH candidate "${dir}" "${abs}")
            if(NOT candidate MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${candidate}")
                set(rel "${candidate}")
                set(root "${dir}")
                break()
            endif()
        endforeach()
        if(NOT rel)
            get_filename_component(rel "${abs}" NAME)
            set(root "${protodir}")
        endif()
        string(REGEX REPLACE "\\.proto$" "" rel "${rel}")
        set(header "${outdir}/${rel}.qpb.h")
        set(source "${outdir}/${rel}.qpb.cpp")
        set(flags)
        foreach(dir IN LISTS includes)
            list(APPEND flags "-I${dir}")
        endforeach()
        list(APPEND flags "-I${protodir}")
        add_custom_command(
            OUTPUT "${header}" "${source}"
            COMMAND ntprotobufgen ${flags} --root "${root}" --output-dir "${outdir}" "${abs}"
            DEPENDS "${abs}" ntprotobufgen
            COMMENT "ntprotobufgen ${proto}"
            VERBATIM)
        list(APPEND headers "${header}")
        list(APPEND sources "${source}")
    endforeach()

    if(NOT TARGET ${target})
        add_library(${target} STATIC)
    endif()
    target_sources(${target} PRIVATE ${sources} ${headers})
    target_include_directories(${target} PUBLIC "${outdir}")
    target_link_libraries(${target} PUBLIC Nt::Protobuf)
    if(arg_OUTPUT_HEADERS)
        set(${arg_OUTPUT_HEADERS} "${headers}" PARENT_SCOPE)
    endif()
    if(arg_OUTPUT_TARGETS)
        set(${arg_OUTPUT_TARGETS} "${target}" PARENT_SCOPE)
    endif()
endfunction()

if(NOT COMMAND qt6_add_protobuf)
    function(qt6_add_protobuf)
        nt_add_protobuf(${ARGV})
        cmake_parse_arguments(arg "" "OUTPUT_HEADERS;OUTPUT_TARGETS" "" ${ARGN})
        foreach(var ${arg_OUTPUT_HEADERS} ${arg_OUTPUT_TARGETS})
            set(${var} "${${var}}" PARENT_SCOPE)
        endforeach()
    endfunction()
endif()
if(NOT COMMAND qt_add_protobuf)
    function(qt_add_protobuf)
        nt_add_protobuf(${ARGV})
        cmake_parse_arguments(arg "" "OUTPUT_HEADERS;OUTPUT_TARGETS" "" ${ARGN})
        foreach(var ${arg_OUTPUT_HEADERS} ${arg_OUTPUT_TARGETS})
            set(${var} "${${var}}" PARENT_SCOPE)
        endforeach()
    endfunction()
endif()
