#
# CPack External generator script that writes a pacman package. CPack runs it
# with the installed tree staged in CPACK_TEMPORARY_DIRECTORY.
#
# A pacman package is a zstd tar archive holding .PKGINFO and the files.

foreach(var CPACK_TEMPORARY_DIRECTORY CPACK_TOPLEVEL_DIRECTORY CPACK_PACKAGE_NAME CPACK_PACKAGE_VERSION)
    if(NOT ${var})
        message(FATAL_ERROR "NtPacman.cmake: ${var} is not set")
    endif()
endforeach()

find_program(TAR_EXECUTABLE tar REQUIRED)
find_program(ZSTD_EXECUTABLE zstd REQUIRED)

set(version ${CPACK_NT_PACMAN_VERSION})
if(NOT version)
    set(version ${CPACK_PACKAGE_VERSION})
endif()
set(release ${CPACK_NT_PACMAN_RELEASE})
if(NOT release)
    set(release 1)
endif()
set(arch ${CPACK_NT_PACMAN_ARCH})
if(NOT arch)
    set(arch any)
endif()

# CPack stages each component in its own directory; pacman wants a single tree.
set(root "${CPACK_TOPLEVEL_DIRECTORY}/pacman-root")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(merged FALSE)
foreach(component IN LISTS CPACK_COMPONENTS_ALL)
    if(IS_DIRECTORY "${CPACK_TEMPORARY_DIRECTORY}/${component}")
        file(COPY "${CPACK_TEMPORARY_DIRECTORY}/${component}/" DESTINATION "${root}"
             DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                                   GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        set(merged TRUE)
    endif()
endforeach()
if(NOT merged)
    file(COPY "${CPACK_TEMPORARY_DIRECTORY}/" DESTINATION "${root}"
         DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                               GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()

# Installed size in bytes, as makepkg reports it.
execute_process(COMMAND du -sb "${root}"
                OUTPUT_VARIABLE du_output OUTPUT_STRIP_TRAILING_WHITESPACE)
string(REGEX MATCH "^[0-9]+" size "${du_output}")
string(TIMESTAMP builddate "%s" UTC)

set(info "# Generated by CPack (NtPacman.cmake)\n")
string(APPEND info "pkgname = ${CPACK_PACKAGE_NAME}\n")
string(APPEND info "pkgbase = ${CPACK_PACKAGE_NAME}\n")
string(APPEND info "pkgver = ${version}-${release}\n")
string(APPEND info "pkgdesc = ${CPACK_PACKAGE_DESCRIPTION_SUMMARY}\n")
string(APPEND info "url = ${CPACK_PACKAGE_HOMEPAGE_URL}\n")
string(APPEND info "builddate = ${builddate}\n")
string(APPEND info "packager = ${CPACK_PACKAGE_CONTACT}\n")
string(APPEND info "size = ${size}\n")
string(APPEND info "arch = ${arch}\n")
string(APPEND info "license = MIT\n")
foreach(dep IN LISTS CPACK_NT_PACMAN_DEPENDS)
    string(APPEND info "depend = ${dep}\n")
endforeach()
foreach(dep IN LISTS CPACK_NT_PACMAN_OPTDEPENDS)
    string(APPEND info "optdepend = ${dep}\n")
endforeach()
file(WRITE "${root}/.PKGINFO" "${info}")
execute_process(COMMAND chmod 644 "${root}/.PKGINFO")

file(GLOB entries RELATIVE "${root}" "${root}/*")
list(REMOVE_ITEM entries .PKGINFO)
list(SORT entries)

set(package "${CPACK_TOPLEVEL_DIRECTORY}/${CPACK_PACKAGE_NAME}-${version}-${release}-${arch}.pkg.tar.zst")
file(REMOVE "${package}")
execute_process(
    COMMAND ${TAR_EXECUTABLE} --owner=0 --group=0 --numeric-owner
            -I "${ZSTD_EXECUTABLE} -19 -T0" -cf "${package}" .PKGINFO ${entries}
    WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "NtPacman.cmake: tar failed: ${error}")
endif()

set(CPACK_EXTERNAL_BUILT_PACKAGES "${package}")
