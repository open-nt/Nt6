@PACKAGE_INIT@

# Nt 6: provides Nt6::Core, Nt6::Network, Nt6::Gpio, Nt6::SerialPort, Nt6::Sql, Nt6::DBus, Nt6::HttpServer, Nt6::WebSockets, Nt6::Gui, Nt6::Widgets, Nt6::Svg, Nt6::SvgWidgets, Nt6::Charts, Nt6::OpenGL, Nt6::OpenGLWidgets, Nt6::Qml, Nt6::FM, Nt6::FMQml, Nt6::Gamepad, Nt6::Gltf, Nt6::Barcode, Nt6::Positioning, Nt6::Sensors, Nt6::Protobuf, Nt6::SerialBus, Nt6::Mqtt, Nt6::Device, Nt6::Twin, Nt6::Comms, Nt6::TwinNetwork, Nt6::Multimedia, Nt6::MultimediaWidgets, Nt6::Concurrent, Nt6::Xml, Nt6::Test, and the tools Nt6::moc, Nt6::rcc and Nt6::ndoc.
# Nt::Core and friends, and Qt6::Core and friends, are aliases, so code written against a build tree or
# against Qt 6 works unchanged.

if(CMAKE_VERSION VERSION_LESS 3.18)
    message(FATAL_ERROR "Nt6 needs CMake 3.18 or newer")
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@NT_HAVE_OPENSSL@)
    find_dependency(OpenSSL)
endif()
if(@NT_HAVE_ZLIB@)
    find_dependency(ZLIB)
endif()
if(@NT_HAVE_SQLITE@)
    find_dependency(SQLite3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Nt6Targets.cmake")
# Nt Material Symbols is installed apart from the rest, with its Apache 2.0 icons: it is there if that was installed.
include("${CMAKE_CURRENT_LIST_DIR}/Nt6MaterialSymbolsTargets.cmake" OPTIONAL)

# A cross build has no tools of its own: ntmoc and ntrcc run on the build machine, from NT_HOST_TOOLS_DIR (a
# directory, or the prefix of an installed Nt for the build machine, with them in its bin directory).
if(CMAKE_CROSSCOMPILING)
    set(NT_HOST_TOOLS_DIR "" CACHE PATH "Directory with ntmoc and ntrcc built for the build machine")
    foreach(_nt_tool moc rcc)
        if(NOT TARGET Nt6::${_nt_tool})
            find_program(NT_HOST_nt${_nt_tool} nt${_nt_tool} PATHS "${NT_HOST_TOOLS_DIR}" "${NT_HOST_TOOLS_DIR}/bin"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
            if(NOT NT_HOST_nt${_nt_tool})
                set(Nt6_FOUND FALSE)
                set(Nt6_NOT_FOUND_MESSAGE "nt${_nt_tool} was not found: set NT_HOST_TOOLS_DIR to a directory with ntmoc and ntrcc for the build machine")
                return()
            endif()
            add_executable(Nt6::${_nt_tool} IMPORTED GLOBAL)
            set_target_properties(Nt6::${_nt_tool} PROPERTIES IMPORTED_LOCATION "${NT_HOST_nt${_nt_tool}}")
        endif()
    endforeach()
    # ntprotobufgen is optional: without it qt_add_protobuf() is not there.
    if(NOT TARGET Nt6::protobufgen)
        find_program(NT_HOST_ntprotobufgen ntprotobufgen PATHS "${NT_HOST_TOOLS_DIR}" "${NT_HOST_TOOLS_DIR}/bin"
            NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
        if(NT_HOST_ntprotobufgen)
            add_executable(Nt6::protobufgen IMPORTED GLOBAL)
            set_target_properties(Nt6::protobufgen PROPERTIES IMPORTED_LOCATION "${NT_HOST_ntprotobufgen}")
        endif()
    endif()
endif()

set(_nt_modules Core Network Gpio SerialPort Sql DBus HttpServer WebSockets Gui Widgets Svg SvgWidgets Charts OpenGL OpenGLWidgets Qml FM FMQml Gamepad Gltf Barcode Positioning Sensors Protobuf SerialBus Mqtt Device Twin Comms TwinNetwork Multimedia MultimediaWidgets Concurrent Xml Test MaterialSymbols)
if(TARGET Nt6::WaylandCompositor)
    list(APPEND _nt_modules WaylandCompositor)
endif()
foreach(module IN LISTS _nt_modules)
    if(NOT TARGET Nt6::${module})
        continue()
    endif()
    # check_required_components() asks this of each component that find_package() was given.
    set(Nt6_${module}_FOUND TRUE)
    if(NOT TARGET Nt::${module})
        add_library(Nt::${module} ALIAS Nt6::${module})
    endif()
    # The names that a project written for Qt links with, as the build tree of Nt has them. They are left
    # alone if a real Qt 6 was found first.
    if(NOT TARGET Qt6::${module})
        add_library(Qt6::${module} ALIAS Nt6::${module})
    endif()
endforeach()

# NtMoc.cmake, NtRcc.cmake and NtDoc.cmake refer to the tools by their build-tree names.
foreach(tool moc rcc ndoc)
    if(TARGET Nt6::${tool} AND NOT TARGET Nt::${tool})
        add_executable(Nt::${tool} ALIAS Nt6::${tool})
    endif()
endforeach()
if(NOT TARGET ntmoc)
    add_executable(ntmoc ALIAS Nt6::moc)
endif()
if(NOT TARGET ntrcc)
    add_executable(ntrcc ALIAS Nt6::rcc)
endif()
if(NOT TARGET ndoc AND TARGET Nt6::ndoc)
    add_executable(ndoc ALIAS Nt6::ndoc)
endif()
if(NOT TARGET ntprotobufgen AND TARGET Nt6::protobufgen)
    add_executable(ntprotobufgen ALIAS Nt6::protobufgen)
    add_executable(Nt::protobufgen ALIAS Nt6::protobufgen)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NtMoc.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NtRcc.cmake")
if(TARGET ndoc)
    include("${CMAKE_CURRENT_LIST_DIR}/NtDoc.cmake")
endif()
if(TARGET ntprotobufgen)
    include("${CMAKE_CURRENT_LIST_DIR}/NtProtobuf.cmake")
    # The component of Qt that provides qtprotobufgen and qt_add_protobuf().
    if(NOT TARGET Qt6::ProtobufTools)
        add_library(Qt6::ProtobufTools INTERFACE IMPORTED)
    endif()
    if(NOT TARGET Qt6::qtprotobufgen)
        add_executable(Qt6::qtprotobufgen ALIAS Nt6::protobufgen)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NtAndroid.cmake")

check_required_components(Nt6)
