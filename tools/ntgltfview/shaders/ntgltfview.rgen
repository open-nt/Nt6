// MIT License - see LICENSE
//
// Ray generation: one primary ray per pixel from the camera in the push constants, into the storage image, followed
// through mirror reflections when ray traced effects are on. It also writes what DLSS needs of the first hit: its
// depth, and the motion vector to where the previous frame's camera saw the same point.
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

#include "ntgltfview_common.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D image;
layout(set = 0, binding = 4, r32f) uniform image2D depthImage;
layout(set = 0, binding = 5, rg16f) uniform image2D motionImage;

#include "ntgltfview_camera.glsl"

layout(location = 0) rayPayloadEXT HitPayload payload;

const int kMaxBounces = 6; // the primary ray, then reflections and the rays that go on through glass

void main() {
    // The sub-pixel jitter is zero unless DLSS is on.
    const vec2 jitter = vec2(camera.jitterX, camera.jitterY);
    const vec2 samplePos = vec2(gl_LaunchIDEXT.xy) + vec2(0.5) + jitter;
    const vec2 uv = samplePos / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    const vec3 firstDirection = normalize(camera.forward + camera.right * (uv.x * camera.aspect * camera.tanHalfFovY) -
                                          camera.up * (uv.y * camera.tanHalfFovY));
    const int bounces = (camera.flags & kFlagTraceEffects) != 0u ? kMaxBounces : 1;

    vec3 origin = camera.origin;
    vec3 direction = firstDirection;
    vec3 result = vec3(0.0);
    vec3 weight = vec3(1.0);
    float viaMirror = 0.0;
    float depth = 1.0;
    vec2 motion = vec2(0.0);
    for (int bounce = 0; bounce < bounces; ++bounce) {
        payload.color = vec3(0.0);
        payload.distance = -1.0;
        payload.carry = vec3(0.0);
        payload.pad0 = viaMirror;
        payload.pad1 = 0.0;
        traceRayEXT(scene, gl_RayFlagsNoneEXT, 0xff, 0, 0, 0, origin, 0.001, direction, 1.0e4, 0);
        if (bounce == 0) {
            // A miss is placed far away, so that only the camera's turning moves it.
            const float travelled = payload.distance >= 0.0 ? payload.distance : 1.0e5;
            const vec3 point = origin + direction * travelled;
            const float z = dot(point - camera.origin, camera.forward);
            if (payload.distance >= 0.0)
                depth = 1.0 - camera.depthNear / max(z, camera.depthNear);
            const vec3 seen = point - camera.prevOrigin;
            const float prevZ = dot(seen, camera.prevForward);
            if (prevZ > 1.0e-6) {
                const vec3 prevRight = camera.prevRight;
                const vec3 prevUp = camera.prevUp;
                const vec2 prevUv = vec2(dot(seen, prevRight) / (prevZ * camera.aspect * camera.prevTanHalfFovY),
                                         -dot(seen, prevUp) / (prevZ * camera.prevTanHalfFovY)) * 0.5 + 0.5;
                motion = prevUv * vec2(gl_LaunchSizeEXT.xy) - samplePos;
            }
        }
        result += weight * payload.color;
        weight *= payload.carry;
        viaMirror = max(viaMirror, payload.pad1);
        if (bounce == bounces - 1 || max(weight.x, max(weight.y, weight.z)) < 0.01)
            break;
        origin = payload.nextOrigin;
        direction = payload.nextDirection;
    }
    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(camera.swapRedBlue != 0u ? result.bgr : result, 1.0));
    imageStore(depthImage, ivec2(gl_LaunchIDEXT.xy), vec4(depth));
    imageStore(motionImage, ivec2(gl_LaunchIDEXT.xy), vec4(motion, 0.0, 0.0));
}
