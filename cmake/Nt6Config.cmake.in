@PACKAGE_INIT@

# Nt 6: provides Nt6::Core, Nt6::Network, Nt6::SerialPort, Nt6::Sql, Nt6::DBus, Nt6::HttpServer, Nt6::WebSockets, Nt6::Gui, Nt6::Widgets, Nt6::Svg, Nt6::SvgWidgets, Nt6::Concurrent, Nt6::Test, and the tools Nt6::moc, Nt6::rcc and Nt6::ndoc.
# Nt::Core and friends are aliases, so code written against a build tree works unchanged.

if(CMAKE_VERSION VERSION_LESS 3.18)
    message(FATAL_ERROR "Nt6 needs CMake 3.18 or newer")
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@NT_HAVE_OPENSSL@)
    find_dependency(OpenSSL)
endif()
if(@NT_HAVE_ZLIB@)
    find_dependency(ZLIB)
endif()
if(@NT_HAVE_SQLITE@)
    find_dependency(SQLite3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Nt6Targets.cmake")

foreach(module Core Network SerialPort Sql DBus HttpServer WebSockets Gui Widgets Svg SvgWidgets Concurrent Test)
    if(NOT TARGET Nt::${module})
        add_library(Nt::${module} ALIAS Nt6::${module})
    endif()
endforeach()

# NtMoc.cmake, NtRcc.cmake and NtDoc.cmake refer to the tools by their build-tree names.
foreach(tool moc rcc ndoc)
    if(NOT TARGET Nt::${tool})
        add_executable(Nt::${tool} ALIAS Nt6::${tool})
    endif()
endforeach()
if(NOT TARGET ntmoc)
    add_executable(ntmoc ALIAS Nt6::moc)
endif()
if(NOT TARGET ntrcc)
    add_executable(ntrcc ALIAS Nt6::rcc)
endif()
if(NOT TARGET ndoc)
    add_executable(ndoc ALIAS Nt6::ndoc)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NtMoc.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NtRcc.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NtDoc.cmake")

check_required_components(Nt6)
