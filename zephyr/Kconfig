menuconfig NT
	bool "Nt, a clean-room subset of the Qt 6 API"
	depends on CPP
	select REQUIRES_FULL_LIBCPP
	select CPP_EXCEPTIONS
	select CPP_RTTI
	select POSIX_API
	select EVENTFD
	select POSIX_FILE_SYSTEM
	select THREAD_LOCAL_STORAGE
	# Nt writes a number with decimals through vsnprintf(); without floating point in printf, picolibc prints
	# "*float*" in its place. This leaves PICOLIBC_IO_FLOAT as the only level of its printf that is available.
	select REQUIRES_FLOAT_PRINTF
	select DYNAMIC_THREAD
	select DYNAMIC_THREAD_ALLOC
	select POSIX_PRIORITY_SCHEDULING
	help
	  Builds Nt Core for the application: QObject with signals and slots, the event loop,
	  timers, threads, the containers and strings, JSON, XML and the item models. Link the
	  application with Nt::Core.

	  Nt uses C++17, exceptions, run-time type information, POSIX threads and the heap. It suits
	  devices with megabytes of flash and RAM, such as the i.MX RT series, not small
	  microcontrollers.

if NT

config NT_THREAD_STACK_SIZE
	int "Stack size of the threads that Nt starts"
	default 8192
	help
	  The stack size, in bytes, of a QThread that was given none with QThread::setStackSize(),
	  of the threads of a QThreadPool and of the threads that Nt starts for itself, such as the
	  one that resolves a host name. The stacks are allocated from the kernel heap
	  (CONFIG_HEAP_MEM_POOL_SIZE).

config NT_NETWORK
	bool "Nt Network"
	depends on NETWORKING
	depends on NET_SOCKETS
	help
	  Builds Nt Network: QTcpSocket, QTcpServer, QUdpSocket, QHostAddress, QHostInfo and
	  QNetworkAccessManager for http:. Link the application with Nt::Network.

	  QLocalSocket and QLocalServer are not available on Zephyr.

config NT_HTTPSERVER
	bool "HTTP server and WebSockets"
	depends on NT_NETWORK
	help
	  Builds Nt HTTP Server and Nt WebSockets: QHttpServer with routing, JSON and file responses,
	  chunked replies and WebSocket upgrades, and QWebSocket and QWebSocketServer. Link the
	  application with Nt::HttpServer or Nt::WebSockets. With CONFIG_NT_TLS they also serve and
	  connect over TLS.

config NT_TLS
	bool "TLS for Nt Network, with Mbed TLS"
	depends on NT_NETWORK
	select PSA_CRYPTO
	select MBEDTLS
	select MBEDTLS_SSL_PROTO_TLS1_2
	select MBEDTLS_X509_CRT_PARSE_C
	select MBEDTLS_PK_PARSE_C
	select MBEDTLS_PK_WRITE_C
	select MBEDTLS_PEM_PARSE_C
	select MBEDTLS_SSL_ALPN
	select MBEDTLS_SSL_SERVER_NAME_INDICATION
	imply MBEDTLS_CIPHERSUITE_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
	imply MBEDTLS_CIPHERSUITE_TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
	imply MBEDTLS_CIPHERSUITE_TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
	imply MBEDTLS_CIPHERSUITE_TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
	help
	  Builds QSslSocket, QSslServer, QSslCertificate, QSslKey and QSslConfiguration on Mbed TLS,
	  and with them https: in QNetworkAccessManager. Without this option QT_NO_SSL is defined
	  and the classes are absent.

	  TLS 1.2 is enabled with the ECDHE ciphers of AES-GCM; add other versions and ciphers
	  with the options of Mbed TLS, such as CONFIG_MBEDTLS_SSL_PROTO_TLS1_3. Mbed TLS takes its
	  random numbers from PSA, which needs an entropy source on the board, and it checks the
	  dates of certificates only with CONFIG_MBEDTLS_HAVE_TIME_DATE and a clock that is set.

endif # NT

# The event loop of a thread waits in one poll() for all of its sockets. Zephyr counts what poll() waits for (a
# connected TCP socket takes two events, one for reading and one for writing) and fails above this limit, whose default
# of 3 is used up by a single connection. Nt copes with any limit of 3 or more, by polling in groups, but each group
# adds up to 10 ms of delay for the sockets in the others, so a higher limit gives lower latency with many sockets.
# The kernel keeps this many events on the stack of the thread that polls.
config ZVFS_POLL_MAX
	default 16 if NT
